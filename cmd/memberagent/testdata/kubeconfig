apiVersion: v1
kind: Config
clusters:
- cluster:
    server: https://hub.fixture.example.com
    insecure-skip-tls-verify: true
  name: hub
contexts:
- context:
    cluster: hub
    user: fixture-user
  name: hub
current-context: hub
users:
- name: fixture-user
  user:
    token: fixture-bearer-token
