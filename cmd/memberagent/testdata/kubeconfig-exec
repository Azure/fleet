apiVersion: v1
kind: Config
clusters:
- cluster:
    server: https://hub.fixture.example.com
    insecure-skip-tls-verify: true
  name: hub
contexts:
- context:
    cluster: hub
    user: fixture-exec-user
  name: hub
current-context: hub
users:
- name: fixture-exec-user
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1
      command: kubelogin
      args:
      - get-token
      - --server-id
      - fixture-server-id
      - --login
      - workloadidentity
      provideClusterInfo: false
      interactiveMode: Never
